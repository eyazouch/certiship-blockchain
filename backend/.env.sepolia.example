# Configuration pour le réseau de test public Sepolia.
# Copier ce fichier en `.env.sepolia` (il n'est pas commité) puis compléter.
# La démo locale Anvil (fichier .env, base data/app.db) n'est pas touchée.

PORT=4000
# Généré automatiquement par scripts/deploy-sepolia.mjs s'il est laissé tel quel
JWT_SECRET=a-generer
CORS_ORIGIN=http://localhost:5173
# Base séparée de celle d'Anvil
DB_PATH=./data/sepolia.db

# --- Blockchain -------------------------------------------------------------
CHAIN_ID=11155111
# URL RPC Sepolia (Alchemy, Infura…). Ne jamais la publier : elle contient une clé d'API.
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/VOTRE_CLE
# Renseignés automatiquement par scripts/deploy-sepolia.mjs
CONTRACT_ADDRESS=
DEPLOY_BLOCK=0
SYNC_INTERVAL_MS=12000
# L'offre gratuite d'Alchemy limite eth_getLogs à 10 blocs par requête
LOG_BLOCK_RANGE=10

# --- Déploiement (scripts/deploy-sepolia.mjs) ------------------------------
# Nom du keystore créé avec : cast wallet import deployer --interactive
DEPLOY_ACCOUNT=deployer
# Adresse du compte qui déploie : il devient administrateur du contrat
DEPLOYER_ADDRESS=0x...
# Adresses autorisées dès le déploiement (séparées par des virgules)
SUPPLIERS=0x...
OPERATORS=0x...

# --- Compte administrateur de l'application (npm run seed:sepolia) ---------
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@certiship.test
ADMIN_PASSWORD=choisir-un-mot-de-passe
# Laisser vide : reprend DEPLOYER_ADDRESS
ADMIN_WALLET=
